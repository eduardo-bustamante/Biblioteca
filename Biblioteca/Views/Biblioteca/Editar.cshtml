@model BibliotecaModel
@{
    ViewData["title"] = "Editar Livro";
}


<div class="container bg-body-tertiary p-5 rounded-5">
    <form method="post" enctype="multipart/form-data" asp-controller="Biblioteca" asp-action="Editar">
    <div class="row">
        <div class="col-7">
                <div class="row">
                    <div class="col text-center mb-3">
                        <h3>Editar Livro</h3>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-3">
                        <label class="form-label">Código</label>
                        <input type="text" class="form-control" id="Id" asp-for="Id" disabled>
                    </div>
                    <div class="col-sm-3">
                        <label class="form-label">Emprestado</label>
                        <input type="checkbox" class="form-check-input" id="Emprestado" asp-for="Lido">
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-8">
                        <label class="form-label">Titulo</label>
                        <input type="text" class="form-control" id="Titulo" asp-for="Titulo">
                    </div>
                    <div class="col-sm-4">
                        <label class="form-label">Autor</label>
                        <input type="text" class="form-control" id="Autor" asp-for=" Autor" as>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-sm-6">
                        <label class="form-label">Coleção</label>
                        <input type="text" class="form-control" id="Colecao" asp-for="Colecao">
                    </div>
                    <div class="col-sm-4">
                        <label class="form-label">Volume</label>
                        <input type="number" class="form-control" id="Volume" asp-for="Volume">
                    </div>
                    <div class="col-sm-2">
                        <label class="form-label">Páginas</label>
                        <input type="number" class="form-control" id="Paginas" asp-for="Paginas">
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-sm-6">
                        <label class="form-label">Idioma</label>
                        <select class="form-select" aria-label="" asp-for="Idioma">
                            <option value="português" selected>Português</option>
                            <option value="Español">Español</option>
                            <option value="English">English</option>
                        </select>
                    </div>
                    <div class="col-sm-2">
                        <label class="form-label">Ano</label>
                        <input type="number" class="form-control" id="Ano" asp-for="Ano">
                    </div>
                    <div class="col-sm-4">
                        <label class="form-label">Editora</label>
                        <input type="text" class="form-control" id="Editora" asp-for="Editora">
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-sm-5">
                        <label class="form-label">Tema</label>
                        <input type="text" class="form-control" id="Tema" asp-for="Tema">

                    </div>
                    

                </div>

                <div class="row">
                    <div class="d-flex gap-5 mt-5">
                        <button type="submit" class="btn btn-success w-50">Editar</button>
                        <a class="btn btn-primary w-50" asp-controller="Biblioteca" asp-action="Index">Voltar</a>
                    </div>
                </div>
         
        </div>
        <div class="col-5">
            <div class="col-sm-7">
                <h4>Capa</h4>
                <img src="@Html.DisplayFor(x => x.Capa)" width="300" height="400" id="mostrarCapa"/>
                <input type="hidden" class="form-control" id="Data" asp-for="DataCadastro"> <!--Para preservar a data do banco de dados, o item esta oculto -->
                    <input class="mt-1" type="button" id="alterarBotao" onclick="mudarTipo()" value="Alterar Imagem">
                <div class="row mt-1">
                    <div class="col">
                            <input type="hidden" id="nomeCapa" name="capa" class="form-control" accept="image/*" onchange="previewImage(event)" asp-for="Capa" />
                    </div>
                    <div class="col-sm-2">
                            
                            <a id="cancelBotao" hidden><img src="~/img/cancel.png" alt="" width="40px" onclick="cancelar()"/></a>

                    </div>
                </div>
                

            </div>
        </div>



    </div>  
       </form>
    
</div>

<script>
    const input = document.getElementById('nomeCapa');
    const cancelbotao = document.getElementById('cancelBotao')
    const botao = document.getElementById('alterarBotao')

    function mudarTipo() {
        input.type = 'file'; // Mudar para o tipo desejado
        cancelbotao.hidden = false;
        botao.hidden = true;
        }

    function cancelar(){
        input.type = 'hidden'; // Mudar para o tipo desejado
        cancelbotao.hidden = true;

        botao.hidden = false;

    }

    function previewImage(event) {
        const input = event.target;
        const preview = document.getElementById('mostrarCapa');

        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function (e) {
                preview.src = e.target.result;
                preview.style.display = 'block'; // Exibe a imagem
            }
            reader.readAsDataURL(input.files[0]); // Converte a imagem para uma URL
        } else {
            preview.src = '#';
            preview.style.display = 'none'; // Esconde a imagem se não houver arquivo
        }
    }
</script>
